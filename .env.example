# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only configuration
APP_ORIGIN=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Azure DevOps OAuth configuration
# Redirect URI: ${APP_ORIGIN}/api/integrations/azure-devops/callback
AZURE_DEVOPS_ENTRA_TENANT_ID=organizations
AZURE_DEVOPS_ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000000
AZURE_DEVOPS_ENTRA_CLIENT_SECRET=your-entra-client-secret
AZURE_DEVOPS_OAUTH_SCOPES=openid profile email offline_access 499b84ac-1321-427f-aa17-267ca6975798/.default
AZURE_DEVOPS_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
AZURE_DEVOPS_TOKEN_KEY_ID=azure-devops-key-1
